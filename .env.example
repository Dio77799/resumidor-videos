# Copia este archivo como .env y rellena solo lo que uses. .env NO se sube al repo.
# Proveedor por defecto: ollama (gratis, local) | anthropic | openai
PROVEEDOR=ollama
OLLAMA_MODELO=llama3.2:3b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: vatios que consume tu equipo trabajando (para estimar Wh) y búsqueda de Whisper (1 rápido, 5 preciso)
# WATTS_EQUIPO=45
# WHISPER_BEAM=1
